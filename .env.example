# =============================================================================
# Universidade Dataweb — variáveis de ambiente
# Copie para `.env.local` e preencha. `.env*.local` é gitignored.
# =============================================================================

# --- Backoffice (operador) ---------------------------------------------------
# Senha MASTER do backoffice (/admin/login com e-mail em branco) — acesso de
# emergência; no histórico as ações aparecem como "Master". Os administradores
# têm contas individuais (migração 0009) com senha própria.
# Default em dev: "dataweb".
ADMIN_PASSWORD=

# Opcional: segredo dedicado para assinar a sessão do backoffice. Sem ele, a
# assinatura deriva da ADMIN_PASSWORD (trocar a senha derruba as sessões).
# ADMIN_SESSION_SECRET=

# --- Supabase ----------------------------------------------------------------
# URL e chave pública (anon). Seguras para o client SE o RLS estiver ativo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de SERVICE ROLE: ignora o RLS. NUNCA exponha no client.
# Use somente no servidor (rotinas administrativas, emissão de certificado).
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mails da plataforma (SMTP via Resend) ----------------------------------
# Envios (o remetente visível é sempre MAIL_FROM = eiglesias@dataweb.com.br):
#   1. Aviso interno de nova solicitação (acesso / esqueci minha senha),
#      para marketing@dataweb.com.br e comercial@dataweb.com.br.
#   2. Confirmação ao solicitante quando a conta é aprovada no backoffice.
#
# Provedor: Resend (https://resend.com), com o domínio dataweb.com.br
# verificado (Domains → Add Domain → adicionar os registros DNS indicados).
# O Google Workspace Starter não permite senha de app, então o SMTP do Gmail
# não é uma opção. SMTP_USER é literalmente "resend"; SMTP_PASSWORD é a chave
# da API (https://resend.com/api-keys, começa com "re_").
# Sem estas variáveis os envios são ignorados (nada quebra nos fluxos).
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM=eiglesias@dataweb.com.br

# URL pública do app. ESSENCIAL em produção: é a base do link pessoal de
# criação de senha enviado nos e-mails de aprovação (/primeiro-acesso?token=…).
APP_URL=

# Opcionais: destinos do aviso interno separados por vírgula (default acima)
# e servidor SMTP (default smtp.resend.com:465 com TLS).
# BACKOFFICE_NOTIFY_EMAIL=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
